# ==========================================
# Finix API - Variables de Entorno
# ==========================================

# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/finix

# JWT Secrets (cambia estos en producción!)
JWT_SECRET=tu_jwt_secret_super_seguro_cambia_esto_en_produccion
JWT_REFRESH_SECRET=tu_refresh_secret_super_seguro_cambia_esto_en_produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=finix-api

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Seguridad
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
